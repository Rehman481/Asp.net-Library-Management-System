@model Library_Management_System.Models.ViewModels.BorrowViewModel

<form id="borrowForm" method="post" asp-action="Create">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="BookId" />
    <input type="hidden" asp-for="StudentName" value="@User.Identity.Name" />

    <div class="mb-3">
        <label asp-for="Purpose" class="form-label">Purpose *</label>
        <textarea asp-for="Purpose" class="form-control" rows="3" placeholder="Why do you need this book?" required></textarea>
        <span asp-validation-for="Purpose" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BorrowDurationDays" class="form-label">Duration *</label>
        <select asp-for="BorrowDurationDays" class="form-control" required>
            <option value="">Select days</option>
            <option value="7">7 days</option>
            <option value="14">14 days</option>
            <option value="21">21 days</option>
            <option value="30">30 days</option>
        </select>
        <span asp-validation-for="BorrowDurationDays" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane me-2"></i>Submit Request
        </button>
    </div>
</form>

<script>
    // Form validation and submission
    document.querySelector('#borrowForm').addEventListener('submit', function(e) {
        e.preventDefault();

        if (!this.checkValidity()) {
            this.reportValidity();
            return;
        }

        // Submit via AJAX
        const formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                // Trigger success action
                if (typeof window.onBorrowSuccess === 'function') {
                    window.onBorrowSuccess(data);
                }
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred. Please try again.');
        });
    });
</script>
@model List<Library_Management_System.Models.ViewModels.BorrowViewModel>

@if (Model.Any())
{
    <div class="list-group">
        @foreach (var borrow in Model)
        {
            <div class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">@borrow.BookTitle</h6>
                    <small class="text-muted">@borrow.RequestDate.("MMM dd")</small>
                </div>
                <p class="mb-1">@borrow.Purpose</p>
                <small class="text-muted">Duration: @borrow.BorrowDurationDays days</small>
                <div class="mt-2">
                    <span class="badge @(borrow.Status == "Pending" ? "bg-warning" :
                                                                 borrow.Status == "Approved" ? "bg-success" :
                                                                 borrow.Status == "Rejected" ? "bg-danger" : "bg-secondary")">
                @borrow.Status
            </span>
        </div>
    </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i> No borrow requests yet.
    </div>
}
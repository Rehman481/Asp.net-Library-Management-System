@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container-fluid py-4">
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-primary mb-1"><i class="fas fa-tachometer-alt me-2"></i>Student Dashboard</h1>
            <p class="text-muted mb-0">Welcome back, <span class="fw-semibold">@ViewBag.StudentName</span> • Manage your library activities</p>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge bg-primary-subtle text-primary fs-6 me-3">
                <i class="fas fa-user-graduate me-1"></i>Student Account
            </span>
            <div class="vr me-3"></div>
            <span class="text-muted small">
                <i class="fas fa-calendar-alt me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </span>
        </div>
    </div>

    <!-- Stats Overview Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-white-50 mb-2">TOTAL BORROWS</p>
                            <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalBorrows</h2>
                            <div class="mt-3">
                                <span class="badge bg-white text-primary fs-7">
                                    <i class="fas fa-chart-line me-1"></i>All Time
                                </span>
                            </div>
                        </div>
                        <div class="icon-wrapper bg-white bg-opacity-20 rounded-circle p-3">
                            <i class="fas fa-book fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-primary bg-opacity-25 border-0 py-3">
                    <a href="/Borrow/MyBorrows" class="text-white text-decoration-none small">
                        View Details <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm bg-gradient-warning h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-dark mb-2">PENDING REQUESTS</p>
                            <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.PendingCount</h2>
                            <div class="mt-3">
                                <span class="badge bg-dark text-warning fs-7">
                                    <i class="fas fa-clock me-1"></i>Awaiting Approval
                                </span>
                            </div>
                        </div>
                        <div class="icon-wrapper bg-dark bg-opacity-10 rounded-circle p-3">
                            <i class="fas fa-clock fa-2x text-dark"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-warning bg-opacity-25 border-0 py-3">
                    <a href="/Borrow/MyBorrows?status=Pending" class="text-dark text-decoration-none small">
                        Manage Requests <i class="fas fa-external-link-alt ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm bg-gradient-success text-white h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-white-50 mb-2">ACTIVE BORROWS</p>
                            <h2 class="display-6 fw-bold mb-0">@ViewBag.ApprovedCount</h2>
                            <div class="mt-3">
                                <span class="badge bg-white text-success fs-7">
                                    <i class="fas fa-check-circle me-1"></i>Currently Reading
                                </span>
                            </div>
                        </div>
                        <div class="icon-wrapper bg-white bg-opacity-20 rounded-circle p-3">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-success bg-opacity-25 border-0 py-3">
                    <a href="/Borrow/MyBorrows?status=Approved" class="text-white text-decoration-none small">
                        Manage Active <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm bg-gradient-info text-white h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-white-50 mb-2">RETURNED BOOKS</p>
                            <h2 class="display-6 fw-bold mb-0">@ViewBag.ReturnedCount</h2>
                            <div class="mt-3">
                                <span class="badge bg-white text-info fs-7">
                                    <i class="fas fa-history me-1"></i>Reading History
                                </span>
                            </div>
                        </div>
                        <div class="icon-wrapper bg-white bg-opacity-20 rounded-circle p-3">
                            <i class="fas fa-check-double fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-info bg-opacity-25 border-0 py-3">
                    <a href="/Borrow/MyBorrows?status=Returned" class="text-white text-decoration-none small">
                        View History <i class="fas fa-history ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row g-4">
        <!-- Recent Borrows Panel -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0 text-primary">
                                <i class="fas fa-history me-2"></i>Recent Borrow Activity
                            </h5>
                            <p class="text-muted small mb-0">Your latest book requests and status updates</p>
                        </div>
                        <div>
                            <span class="badge bg-primary-subtle text-primary">
                                <i class="fas fa-sync-alt me-1"></i>Real-time Updates
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentBorrows == null || ViewBag.RecentBorrows.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="mb-4">
                                <i class="fas fa-book-open fa-4x text-muted opacity-25"></i>
                            </div>
                            <h5 class="text-muted mb-3">No Recent Activity</h5>
                            <p class="text-muted mb-4">You haven't borrowed any books yet. Start exploring our collection!</p>
                            <a href="/Book/Catalog" class="btn btn-primary px-4">
                                <i class="fas fa-search me-2"></i>Browse Library Catalog
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">
                                            <span class="d-flex align-items-center">
                                                <i class="fas fa-hashtag me-2 text-muted"></i>BOOK ID
                                            </span>
                                        </th>
                                        <th>
                                            <span class="d-flex align-items-center">
                                                <i class="fas fa-calendar me-2 text-muted"></i>REQUEST DATE
                                            </span>
                                        </th>
                                        <th>
                                            <span class="d-flex align-items-center">
                                                <i class="fas fa-tag me-2 text-muted"></i>STATUS
                                            </span>
                                        </th>
                                        <th class="pe-4">
                                            <span class="d-flex align-items-center">
                                                <i class="fas fa-clock me-2 text-muted"></i>DUE DATE
                                            </span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var borrow in ViewBag.RecentBorrows)
                                    {
                                        <tr class="border-top">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 text-primary rounded-2 p-2 me-3">
                                                        <i class="fas fa-bookmark"></i>
                                                    </div>
                                                    <div>
                                                        <span class="fw-semibold">#@borrow.BookId</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-nowrap">
                                                    <span class="fw-medium">@borrow.RequestDate.ToString("MMM dd, yyyy")</span>
                                                    <div class="text-muted small">@borrow.RequestDate.ToString("hh:mm tt")</div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (borrow.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2">
                                                        <i class="fas fa-clock me-1"></i>Pending
                                                    </span>
                                                }
                                                else if (borrow.Status == "Approved")
                                                {
                                                    <span class="badge bg-success text-white px-3 py-2">
                                                        <i class="fas fa-check-circle me-1"></i>Approved
                                                    </span>
                                                }
                                                else if (borrow.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger text-white px-3 py-2">
                                                        <i class="fas fa-times-circle me-1"></i>Rejected
                                                    </span>
                                                }
                                                else if (borrow.Status == "Returned")
                                                {
                                                    <span class="badge bg-info text-white px-3 py-2">
                                                        <i class="fas fa-check-double me-1"></i>Returned
                                                    </span>
                                                }
                                            </td>
                                            <td class="pe-4">
                                                @if (borrow.DueDate != null)
                                                {
                                                    <div class="text-nowrap">
                                                        <span class="fw-medium">@borrow.DueDate.ToString("MMM dd, yyyy")</span>
                                                        <div class="text-muted small">
                                                            @{
                                                                var dueDate = (DateTime)borrow.DueDate;
                                                                var timeSpan = dueDate - DateTime.Now;
                                                                var totalDays = (int)timeSpan.TotalDays;

                                                                if (totalDays > 0)
                                                                {
                                                                    <span class="text-success"><i class="fas fa-calendar-check me-1"></i>@totalDays days left</span>
                                                                }
                                                                else if (totalDays == 0)
                                                                {
                                                                    <span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Due today</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Overdue by @Math.Abs(totalDays) days</span>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Not assigned</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small">
                                        <i class="fas fa-info-circle me-1"></i>Showing @ViewBag.RecentBorrows.Count most recent records
                                    </span>
                                </div>
                                <a href="/Borrow/MyBorrows" class="btn btn-outline-primary px-4">
                                    <i class="fas fa-list me-2"></i>View Complete History
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions & System Status -->
        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="/Book/Catalog" class="btn btn-outline-primary w-100 h-100 p-3 d-flex flex-column align-items-center justify-content-center">
                                <i class="fas fa-search fa-2x mb-2"></i>
                                <span class="fw-medium">Browse Books</span>
                                <small class="text-muted mt-1">Explore Catalog</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/Borrow/MyBorrows" class="btn btn-outline-success w-100 h-100 p-3 d-flex flex-column align-items-center justify-content-center">
                                <i class="fas fa-book fa-2x mb-2"></i>
                                <span class="fw-medium">My Borrows</span>
                                <small class="text-muted mt-1">Manage Requests</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/Home/Index" class="btn btn-outline-secondary w-100 h-100 p-3 d-flex flex-column align-items-center justify-content-center">
                                <i class="fas fa-home fa-2x mb-2"></i>
                                <span class="fw-medium">Home</span>
                                <small class="text-muted mt-1">Go to Homepage</small>
                            </a>
                        </div>
                        <div class="col-6">
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="btn btn-outline-danger w-100 h-100 p-3 d-flex flex-column align-items-center justify-content-center">
                                    <i class="fas fa-sign-out-alt fa-2x mb-2"></i>
                                    <span class="fw-medium">Logout</span>
                                    <small class="text-muted mt-1">End Session</small>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Status Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="fas fa-server me-2"></i>System Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">
                                <i class="fas fa-database me-2"></i>Library Database
                            </span>
                            <span class="badge bg-success">
                                <i class="fas fa-circle me-1"></i>Online
                            </span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: 95%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">
                                <i class="fas fa-exchange-alt me-2"></i>Request System
                            </span>
                            <span class="badge bg-success">
                                <i class="fas fa-circle me-1"></i>Active
                            </span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-info" style="width: 88%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">
                                <i class="fas fa-bell me-2"></i>Notifications
                            </span>
                            <span class="badge bg-success">
                                <i class="fas fa-circle me-1"></i>Enabled
                            </span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="fas fa-shield-alt me-1"></i>Last updated: Just now
                            </span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
                                <i class="fas fa-redo"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Notification Toast -->
<div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1056;">
    <div id="notificationToast" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-primary text-white">
            <div class="me-auto d-flex align-items-center">
                <i class="fas fa-bell me-2"></i>
                <strong>Library Notification</strong>
            </div>
            <small class="text-white-50">Just now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-light">
            <div class="d-flex">
                <div class="flex-shrink-0">
                    <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                        <i class="fas fa-info-circle"></i>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-1" id="notificationTitle">System Alert</h6>
                    <p class="mb-0 small" id="notificationMessage">Loading notification...</p>
                </div>
            </div>
        </div>
        <div class="toast-footer bg-white border-top px-3 py-2">
            <div class="d-flex justify-content-between align-items-center">
                <a href="/Borrow/MyBorrows" class="text-decoration-none small">
                    <i class="fas fa-external-link-alt me-1"></i>View Details
                </a>
                <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="toast">
                    Dismiss
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%) !important;
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%) !important;
    }

    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 12px !important;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
        }

    .icon-wrapper {
        transition: transform 0.3s ease;
    }

    .card:hover .icon-wrapper {
        transform: scale(1.1);
    }

    .avatar-sm {
        width: 40px;
        height: 40px;
    }

    .toast {
        border-radius: 12px;
        overflow: hidden;
        max-width: 400px;
    }

    .table > :not(:first-child) {
        border-top: 0;
    }

    .progress {
        border-radius: 10px;
    }

    .btn {
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }
</style>

@section Scripts {
    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        $(function() {
            // Initialize SignalR connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // Handle received notifications
            connection.on("ReceiveNotification", function (title, message) {
                showNotification(title, message);
            });

            // Start connection
            connection.start()
                .then(function () {
                    console.log("SignalR connected successfully");
                    updateConnectionStatus(true);
                })
                .catch(function (err) {
                    console.error("SignalR connection error: ", err.toString());
                    updateConnectionStatus(false);
                });

            // Show notification toast
            function showNotification(title, message) {
                $('#notificationTitle').text(title);
                $('#notificationMessage').text(message);
                const toast = new bootstrap.Toast(document.getElementById('notificationToast'));
                toast.show();

                // Update dashboard status badge
                const pendingBadge = $('.card.bg-gradient-warning .badge');
                if (pendingBadge.length) {
                    const currentCount = parseInt(pendingBadge.closest('.card').find('h2').text().trim());
                    pendingBadge.closest('.card').find('h2').text(currentCount + 1);
                }
            }

            // Update connection status in UI
            function updateConnectionStatus(connected) {
                const statusElement = $('.toast-header .badge');
                if (connected) {
                    statusElement.removeClass('bg-danger').addClass('bg-success')
                        .html('<i class="fas fa-wifi me-1"></i>Connected');
                } else {
                    statusElement.removeClass('bg-success').addClass('bg-danger')
                        .html('<i class="fas fa-wifi-slash me-1"></i>Disconnected');
                }
            }

            // Reconnect if disconnected
            connection.onclose(function () {
                updateConnectionStatus(false);
                setTimeout(function() {
                    connection.start().then(() => updateConnectionStatus(true));
                }, 5000);
            });

            // Add hover effects to table rows
            $('table tbody tr').hover(
                function() {
                    $(this).addClass('shadow-sm').css('transform', 'translateX(5px)');
                },
                function() {
                    $(this).removeClass('shadow-sm').css('transform', 'translateX(0)');
                }
            );

            // Update time display every minute
            function updateTime() {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                $('.text-muted small').html('<i class="fas fa-calendar-alt me-1"></i>' + now.toLocaleDateString('en-US', options));
            }
            setInterval(updateTime, 60000);
        });
    </script>
}
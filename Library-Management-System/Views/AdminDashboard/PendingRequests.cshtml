    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Library_Management_System.Models.Borrow>
@{
    ViewData["Title"] = "Pending Borrow Requests";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center py-3">
        <h1 class="h3 mb-0"><i class="fas fa-clock me-2"></i>Pending Requests</h1>
        <a href="/AdminDashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-check-circle text-success fa-4x mb-3"></i>
                <h3 class="text-muted">No Pending Requests</h3>
                <p class="text-muted">All borrow requests have been processed.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Model.Count Pending Request(s)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Student</th>
                                <th>Book ID</th>
                                <th>Purpose</th>
                                <th>Duration</th>
                                <th>Request Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var borrow in Model)
                            {
                                <tr>
                                    <td>@borrow.Id</td>
                                    <td>
                                        <strong>@borrow.StudentName</strong><br>
                                        <small class="text-muted">@borrow.StudentId.Substring(0, 8)...</small>
                                    </td>
                                    <td>@borrow.BookId</td>
                                    <td>
                                        <small>@(borrow.Purpose.Length > 50 ? borrow.Purpose.Substring(0, 50) + "..." : borrow.Purpose)</small>
                                    </td>
                                    <td>@borrow.BorrowDurationDays days</td>
                                    <td>@borrow.RequestDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td>
                                        <div class="btn-group">
                                            <form method="post" asp-action="QuickApprove" asp-controller="AdminDashboard" class="d-inline">
                                                <input type="hidden" name="id" value="@borrow.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fas fa-check"></i> Approve
                                                </button>
                                            </form>
                                            <form method="post" asp-action="QuickReject" asp-controller="AdminDashboard" class="d-inline">
                                                <input type="hidden" name="id" value="@borrow.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-times"></i> Reject
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-info btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#detailModal@borrow.Id">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>

                                        <!-- Detail Modal -->
                                        <div class="modal fade" id="detailModal@borrow.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Request Details #@borrow.Id</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p><strong>Student:</strong> @borrow.StudentName</p>
                                                        <p><strong>Student ID:</strong> @borrow.StudentId</p>
                                                        <p><strong>Book ID:</strong> @borrow.BookId</p>
                                                        <p><strong>Purpose:</strong> @borrow.Purpose</p>
                                                        <p><strong>Duration:</strong> @borrow.BorrowDurationDays days</p>
                                                        <p><strong>Request Date:</strong> @borrow.RequestDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
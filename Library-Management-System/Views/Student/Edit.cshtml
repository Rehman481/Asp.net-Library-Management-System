@model Library_Management_System.Models.Student
@{
    ViewData["Title"] = "Edit Student";
}

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    body {
        background-color: #60a5fa; /* Light Blue Background */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-custom {
        border-radius: 20px; /* Rounded corners */
        background-color: #1e3a8a; /* Dark Blue Card */
        color: white; /* White text inside */
        border: none;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #3b82f6;
        padding: 12px;
    }

    .form-control:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 0.2rem rgba(96, 165, 250, 0.25);
    }

    .btn-success {
        background: linear-gradient(135deg, #10b981, #059669);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
    }

    .btn-secondary {
        background: linear-gradient(135deg, #6b7280, #4b5563);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
    }
</style>



<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card card-custom shadow-lg w-50">

        <!-- Card Header -->
        <div class="card-header bg-primary text-white text-center py-4">
            <h4 class="mb-1"><i class="fas fa-edit me-2"></i>Edit Student</h4>
            <small class="opacity-75">Update student information</small>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">

            <form asp-action="Edit" method="post" onsubmit="return validateForm();">
                <input type="hidden" asp-for="StudentId" />
                
                <div class="mb-4">
                    <label class="form-label fw-bold">Student Name</label>
                    <input asp-for="StudentName" class="form-control"  placeholder="Enter student name" />
                    <span asp-validation-for="StudentName" class="text-warning small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control"  placeholder="Enter email" />
                    <span asp-validation-for="Email" class="text-warning small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Phone</label>
                    <input asp-for="Phone" class="form-control"  placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-warning small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save me-2"></i>Update
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function validateForm() {
        const studentname = document.querySelector('[name="StudentName"]').value.trim();
        const email = document.querySelector('[name="Email"]').value.trim();
        const phone = document.querySelector('[name="Phone"]').value.trim();

        if (!studentname || !email || !phone) {
            alert("All fields are required: Student Name, Email, and Phone.");
            return false;
        }

        // Email validation
       
        }

        // Phone validation (basic)
        const phoneRegex = /^[\d\s\-\+\(\)]{10,}$/;
        if (!phoneRegex.test(phone)) {
            alert("Please enter a valid phone number.");
            return false;
        }

        return true;
    }

    // Real-time validation
    document.addEventListener('DOMContentLoaded', function() {
        const inputs = document.querySelectorAll('input[required]');
        inputs.forEach(input => {
            input.addEventListener('blur', function() {
                if (!this.value.trim()) {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
            });
        });
    });
</script>
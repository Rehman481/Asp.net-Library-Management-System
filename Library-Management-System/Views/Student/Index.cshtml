@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Library_Management_System.Models.Student>
@{
    ViewData["Title"] = "Students - Library Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
    </style>
</head>
<body class="py-4">
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="card bg-primary text-white border-0 rounded-3 shadow-lg mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h1 class="display-5 fw-bold mb-2"><i class="fas fa-users me-3"></i>Student Management</h1>
                        <p class="mb-0 opacity-75">Manage student information and records</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="input-group ms-auto" style="max-width: 400px;">
                            <input type="text" class="form-control bg-white bg-opacity-10 border-0 text-white"
                                   id="searchInput" placeholder="Search students...">
                            <button class="btn btn-light" id="searchBtn" type="button">
                                <i class="fas fa-search"></i>
                            </button>
                            <button class="btn btn-outline-light" id="clearSearch" type="button" style="display: none;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-users text-white fs-4"></i>
                        </div>
                        <h3 class="text-primary fw-bold">@Model.Count</h3>
                        <p class="text-muted mb-0">Total Students</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="bg-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-envelope text-white fs-4"></i>
                        </div>
                        <h3 class="text-danger fw-bold">@(Model.Any() ? Model.Select(s => s.Email).Distinct().Count() : 0)</h3>
                        <p class="text-muted mb-0">Unique Emails</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="bg-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-phone text-white fs-4"></i>
                        </div>
                        <h3 class="text-info fw-bold">@(Model.Any() ? Model.Select(s => s.Phone).Distinct().Count() : 0)</h3>
                        <p class="text-muted mb-0">Phone Numbers</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-id-card text-white fs-4"></i>
                        </div>
                        <h3 class="text-success fw-bold">@(Model.Any() ? Model.Max(s => s.StudentId) : 0)</h3>
                        <p class="text-muted mb-0">Latest Student ID</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Students Table -->
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-list me-2"></i>Student Records</h4>
                    <a asp-action="Create" class="btn btn-light btn-sm">
                        <i class="fas fa-plus-circle me-2"></i>Add New Student
                    </a>
                </div>
            </div>

            <!-- Search Results Info -->
            <div class="alert alert-info alert-dismissible fade show m-3 mb-0" id="searchInfo" style="display: none;">
                <i class="fas fa-info-circle me-2"></i>
                <span id="searchInfoText"></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users text-muted mb-3" style="font-size: 4rem;"></i>
                    <h4 class="text-muted">No Students Available</h4>
                    <p class="text-muted">Get started by adding your first student record.</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">
                        <i class="fas fa-plus-circle me-2"></i>Add Your First Student
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="studentsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Student ID</th>
                                <th>Student Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTableBody">
                            @foreach (var item in Model)
                            {
                                <tr class="student-row"
                                    data-name="@item.StudentName?.ToLower()"
                                    data-email="@item.Email?.ToLower()"
                                    data-phone="@item.Phone?.ToLower()">
                                    <td class="ps-4 fw-bold text-primary">#@item.StudentId</td>
                                    <td class="student-name fw-semibold">@item.StudentName</td>
                                    <td class="email">
                                        <i class="fas fa-envelope text-muted me-2"></i>@item.Email
                                    </td>
                                    <td class="phone">
                                        <i class="fas fa-phone text-muted me-2"></i>@item.Phone
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.StudentId"
                                               class="btn btn-warning text-white">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.StudentId"
                                               onclick="return confirm('Are you sure you want to delete this student?')"
                                               class="btn btn-danger">
                                                <i class="fas fa-trash me-1"></i>Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- No Results Message -->
                <div class="text-center py-5" id="noResults" style="display: none;">
                    <i class="fas fa-search text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-muted">No Students Found</h4>
                    <p class="text-muted">No students match your search criteria. Try different keywords.</p>
                    <button class="btn btn-primary mt-2" id="clearSearch2" type="button">
                        <i class="fas fa-times me-2"></i>Clear Search
                    </button>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const clearSearch = document.getElementById('clearSearch');
            const clearSearch2 = document.getElementById('clearSearch2');
            const noResults = document.getElementById('noResults');
            const searchInfo = document.getElementById('searchInfo');
            const searchInfoText = document.getElementById('searchInfoText');
            const studentRows = document.querySelectorAll('.student-row');

            // Function to perform search
            function performSearch() {
                const searchTerm = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;
                let hasResults = false;

                if (searchTerm === '') {
                    // Show all rows if search is empty
                    studentRows.forEach(row => {
                        row.style.display = '';
                        visibleCount++;
                    });
                    searchInfo.style.display = 'none';
                    clearSearch.style.display = 'none';
                    noResults.style.display = 'none';
                    return;
                }

                // Search through students
                studentRows.forEach(row => {
                    const name = row.getAttribute('data-name') || '';
                    const email = row.getAttribute('data-email') || '';
                    const phone = row.getAttribute('data-phone') || '';

                    if (name.includes(searchTerm) ||
                        email.includes(searchTerm) ||
                        phone.includes(searchTerm)) {
                        row.style.display = '';
                        visibleCount++;
                        hasResults = true;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Show/hide no results message
                if (!hasResults) {
                    noResults.style.display = 'block';
                    searchInfo.style.display = 'none';
                } else {
                    noResults.style.display = 'none';
                    searchInfo.style.display = 'block';
                    searchInfoText.textContent = `Found ${visibleCount} student(s) matching "${searchTerm}"`;
                }

                clearSearch.style.display = 'block';
            }

            // Function to clear search
            function clearSearchFunction() {
                searchInput.value = '';
                performSearch();
            }

            // Event listeners
            searchBtn.addEventListener('click', function(e) {
                e.preventDefault();
                performSearch();
            });

            searchInput.addEventListener('keyup', function(event) {
                if (event.key === 'Enter') {
                    performSearch();
                }
            });

            clearSearch.addEventListener('click', function(e) {
                e.preventDefault();
                clearSearchFunction();
            });

            clearSearch2.addEventListener('click', function(e) {
                e.preventDefault();
                clearSearchFunction();
            });

            // Real-time search
            searchInput.addEventListener('input', function() {
                performSearch();
            });
        });
    </script>
</body>
</html>
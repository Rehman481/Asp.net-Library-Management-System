@model Library_Management_System.Models.Book
@{
    ViewData["Title"] = "Add New Book";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        
        body {
            position: relative;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

           
            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: url('/images/banner2.jpg') no-repeat center center;
                background-size: cover;
                z-index: -2;
            }

          
            body::after {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.4); 
                z-index: -1;
            }

        
        .add-card {
            border-radius: 20px !important;
            background: rgba(255, 255, 255, 0.15); /* Semi-transparent white */
            backdrop-filter: blur(10px); 
            color: white;
            padding: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

       
        .add-header {
            background: linear-gradient(to right, #93c5fd, #3b82f6, #1e3a8a);
            color: white;
            border-top-left-radius: 20px !important;
            border-top-right-radius: 20px !important;
            padding: 10px 20px;
        }

       
        .add-card input,
        .add-card textarea {
            background: rgba(255, 255, 255, 0.2); 
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

            .add-card input::placeholder,
            .add-card textarea::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }

        
        .add-card .text-danger {
            color: #ffccd5; 
        }


        .add-card .btn-primary {
            background-color: #3b82f6;
            border: none;
        }

        .add-card .btn-secondary {
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
        }
    </style>

</head>
<body>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">

                <div class="card shadow-lg add-card">

                    <!-- Header -->
                    <div class="card-header add-header d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Book</h4>
                            <small>Fill in the details to add a new book</small>
                        </div>
                        <a asp-action="Index" class="text-white text-decoration-underline">
                            <i class="fas fa-arrow-left me-1"></i>Back to Books
                        </a>
                    </div>

                    <!-- Form Body -->
                    <div class="card-body">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6><i class="fas fa-exclamation-circle me-2"></i>Please correct the errors below</h6>
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <form asp-action="Create" method="post">

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="BookName" class="form-label">Book Name *</label>
                                    <input asp-for="BookName" class="form-control rounded-3" required  placeholder="Enter book name" />
                                    <span asp-validation-for="BookName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Author" class="form-label">Author *</label>
                                    <input asp-for="Author" class="form-control rounded-3" required  placeholder="Enter author name" />
                                    <span asp-validation-for="Author" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Genre" class="form-label">Genre</label>
                                    <input asp-for="Genre" class="form-control rounded-3" placeholder="e.g., Fiction, Science" />
                                    <span asp-validation-for="Genre" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="PublicationYear" class="form-label">Publication Year</label>
                                    <input asp-for="PublicationYear" type="number" class="form-control rounded-3" min="1000" max="@DateTime.Now.Year" placeholder="e.g., 2023" />
                                    <span asp-validation-for="PublicationYear" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label">Quantity </label>
                                <input asp-for="Quantity" type="number" class="form-control rounded-3" min="1" value="1" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description (Optional)</label>
                                <textarea asp-for="Description" rows="4" class="form-control rounded-3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary rounded-3">
                                    <i class="fas fa-save me-2"></i>Add Book
                                </button>
                                <a asp-action="Index" class="btn btn-secondary ms-2 rounded-3">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
